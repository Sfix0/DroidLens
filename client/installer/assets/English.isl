; Minimal English language definition for DroidLens installer.
; Only [LangOptions] is declared here — every standard message falls back
; to Inno Setup's built-in English defaults. All installer-specific strings
; live in [CustomMessages] in DroidLens_Installer.iss instead.
[LangOptions]
LanguageName=English
LanguageID=$0409
LanguageCodePage=1252
