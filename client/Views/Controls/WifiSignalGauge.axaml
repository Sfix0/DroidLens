<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DroidLens.Client.Views.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- WifiSignalGauge renders smooth, native vector concentric arcs (ArcTo) over a
         center dot directly in Render() (see WifiSignalGauge.axaml.cs).
         The MaterialIcon in this template is used for the USB fallback (IsUsbMode). -->
    <Style Selector="controls|WifiSignalGauge">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinWidth" Value="14"/>
        <Setter Property="MinHeight" Value="14"/>
        <Setter Property="FillBrush" Value="{DynamicResource AccentIndigoBrush}"/>
        <Setter Property="TrackBrush" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <materialIcons:MaterialIcon x:Name="PART_Icon"
                                                Kind="Usb"
                                                Width="18" Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>