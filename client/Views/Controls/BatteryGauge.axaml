<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DroidLens.Client.Views.Controls">

    <!-- BatteryGauge draws itself entirely in Render() — the ControlTemplate
         only needs to host layout (no visual children required), so this is
         effectively a sizing/default-brush declaration rather than a real
         template tree. -->
    <Style Selector="controls|BatteryGauge">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="MinHeight" Value="9"/>
        <Setter Property="FillBrush" Value="{DynamicResource AccentIndigoBrush}"/>
        <Setter Property="TrackBrush" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent"/>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>